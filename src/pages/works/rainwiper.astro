---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/detail.css";
import { getCollection } from "astro:content";

// Bespoke detail page (the generic [slug].astro skips this slug).
const apps = await getCollection("apps");
const app = apps.find((a) => a.slug === "rainwiper")!;
const { data } = app;

const features = [
  { title: "ガラスを伝うような水滴", body: "水滴がくっついて大きくなったり、途中で引っかかって止まったり。大きな水滴には背景が映り込み、いつものサイトが雨の日の窓辺に変わります。" },
  { title: "ワイパーで、さっとひと拭き", body: "右下のボタンかESCキーで、曇った画面を拭き取れます。「ワイパー自動」を使えば、雨の強さに合わせて自動で動きます。" },
  { title: "霧雨から雷雨、雪まで7種類", body: "霧雨・小雨・雨・強い雨・豪雨・雷雨・雪から選べます。雨音・ワイパー音・雷音の音量も、それぞれ調整できます。" },
  { title: "外で雨が降ると、ブラウザにも", body: "場所を設定すると、実際の天気に合わせて雨をON/OFF。手動で好きな天気を選ぶこともできます。" },
  { title: "動画の上でも、軽くなめらかに", body: "1.0.8では水滴の描き方を作り直しました。動画の上で強い雨を降らせるときも軽く動き、さらに負担を減らしたいときは「軽量モード」を選べます。" },
];

const demos = [
  { src: "/assets/rainwiper/demo1.png", alt: "写真ポートフォリオに雨を重ねたデモ" },
  { src: "/assets/rainwiper/demo2.png", alt: "天気予報サイトに雨を重ねたデモ" },
  { src: "/assets/rainwiper/demo3.png", alt: "コーヒー店サイトに雨を重ねたデモ" },
];

const otherWorks = [
  { slug: "inkpress", name: "InkPress", desc: "軽くて静かな自炊本リーダー。", icon: "/assets/apps/inkpress-icon.png" },
  { slug: "cosmo-cleaner", name: "COSMO CLEANER", desc: "CRT風の宇宙清掃シューティング。", icon: "/assets/apps/cosmo-cleaner-icon.png" },
  { slug: "pinokun-stamps", name: "LINEスタンプと絵文字", desc: "使いやすい絵文字やスタンプたち。", icon: "/assets/apps/pinokun-stamps-icon.png" },
];
---

<BaseLayout title={`${data.title} — Y.M Apps`} description="ブラウザに雨を降らせて、ワイパーで拭くChrome拡張。雨ふりブラウザ1.0.8では、水滴がより自然に、動作も軽くなりました。紹介動画も公開中。">
  <section class="stack-section">
    <div class="container detail-page">

      <nav class="crumb">
        <a href="/">Home</a><span class="sep">/</span>
        <a href="/#works">Works</a><span class="sep">/</span>
        <span class="cur">{data.title}</span>
      </nav>

      <section class="detail-hero" data-reveal>
        <div class="hero-banner">
          <img src="/assets/hero/rainwiper-hero.png" alt="RainWiper（雨ふりブラウザ）— Web ページに、本物のような雨とワイパーを" />
        </div>
        <div class="card meta-bar">
          <div class="mb-status"><span class="badge-live">公開中 — Chrome ウェブストア</span></div>
          <div class="mb-chips">
            <span class="chip">Chrome拡張</span>
            <span class="chip">v{data.version}</span>
            <span class="chip chip-gold">RainWiper</span>
          </div>
          <div class="mb-actions">
            <a class="btn btn-outline" href="https://note.com/y_m656/n/n673462bf744d" target="_blank" rel="noopener noreferrer">制作の話を読む</a>
            <a class="btn btn-primary" href={data.storeUrl} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l2.5 6.5L21 11l-6.5 2.5L12 20l-2.5-6.5L3 11l6.5-1.5L12 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>
              Chrome ウェブストアで見る
            </a>
          </div>
        </div>
      </section>

      <div class="detail-body">

        <section class="block" data-reveal>
          <span class="lede">ABOUT</span>
          <h2>この拡張について</h2>
          <div class="about-text">
            <p>見ている Web ページの上に、ガラスを伝う本物のような雨と、それを拭き取るワイパーを重ねる Chrome 拡張です。はじめて作った拡張機能でもあります。</p>
            <p class="pull">雨を降らせて、ワイパーで拭く。ふだんのブラウジングに、ちょっとした遊び心を添える道具です。</p>
          </div>
        </section>

        <section class="block" aria-labelledby="release-title">
          <span class="lede">UPDATE</span>
          <h2 id="release-title">1.0.8で、雨粒をもっと自然に、軽く。</h2>
          <p><time datetime="2026-10-22">2026年10月22日更新</time></p>
          <ul>
            <li>水滴のふちに影や光を加え、ガラスの上の水玉らしい見た目に。流れる速さや途中で止まる動き、くっついたときの大きさも調整しました。</li>
            <li>水滴の描き方を作り直し、動画の上で強い雨を降らせても、なめらかに動くようになりました。</li>
            <li>設定を一画面に整理。雨の種類はボタンで選べて、音量やワイパーの設定も見つけやすくなりました。</li>
            <li>YouTubeなど、一部のサイトでワイパー音の読み込みエラーが出る問題を直しました。</li>
          </ul>
        </section>

        <section class="block" aria-labelledby="video-title">
          <span class="lede">VIDEO</span>
          <h2 id="video-title">雨の降り方を、動画で。</h2>
          <p class="about-text">流れる水滴やワイパー、雷雨や雪の様子を約47秒で紹介します。音声と日本語の文字・英語字幕付きです。</p>
          <iframe
            class="intro-video"
            src="https://www.youtube-nocookie.com/embed/m_QvdxGifgM"
            title="雨ふりブラウザ 紹介動画：水滴・ワイパー・雷雨・雪"
            width="960"
            height="540"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
          <p><a href="https://youtu.be/m_QvdxGifgM" target="_blank" rel="noopener noreferrer">YouTubeで紹介動画を見る</a></p>
        </section>

        <section class="block" data-reveal>
          <span class="lede">FEATURES</span>
          <h2>できること</h2>
          <div class="features">
            {features.map((f, i) => (
              <div class="feature">
                <span class="fnum">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="block" data-reveal>
          <span class="lede">DEMO</span>
          <h2>いろんなサイトで</h2>
          <p class="about-text lineup-lede">写真サイトでも、天気予報でも、コーヒー店のページでも。開いているそのページに、そのまま雨が降ります。Chromeの設定画面やウェブストアなど、一部のページでは使えません。</p>
          <div class="shots">
            {demos.map((d) => (
              <div class="shot"><img src={d.src} alt={d.alt} loading="lazy" decoding="async" /></div>
            ))}
          </div>
        </section>

      </div>

      <section class="other" data-reveal>
        <h2>ほかの作品</h2>
        <div class="other-grid">
          {otherWorks.map((w) => (
            <a class="owork" href={`/works/${w.slug}`}>
              <span class="oi"><img src={w.icon} alt="" /></span>
              <span><b>{w.name}</b><span>{w.desc}</span></span>
            </a>
          ))}
        </div>
        <a class="back-link" href="/#works">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          Works に戻る
        </a>
      </section>

    </div>
  </section>
</BaseLayout>

<style>
  .intro-video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    margin-top: 24px;
    border: 0;
    border-radius: 16px;
    background: #111;
  }
</style>
