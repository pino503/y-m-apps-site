---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/detail.css";
import { getCollection } from "astro:content";

// Bespoke detail page（GTDメモのレイアウトを踏襲）。きろくナビは Google Play
// 未公開の福祉事業所向けAndroidアプリで、導入はお問い合わせ経由。CTA は
// 準備中の無効ボタンではなく /contact?from=kirokunavi への導線にしてある。
const apps = await getCollection("apps");
const app = apps.find((a) => a.slug === "kirokunavi")!;
const { data } = app;

const features = data.features;

const shots = [
  { src: "/assets/apps/kirokunavi-kiroku.jpg", alt: "きろくナビ スクリーンショット（日々の記録の一覧）" },
  { src: "/assets/apps/kirokunavi-sogei.jpg", alt: "きろくナビ スクリーンショット（送迎の割り当て）" },
  { src: "/assets/apps/kirokunavi-output.jpg", alt: "きろくナビ スクリーンショット（記録の出力）" },
];

const otherWorks = [
  { slug: "kikulog", name: "キクログ", desc: "面談の記録づくりを、聞きながらその場で。", icon: "/assets/apps/kikulog-icon.png" },
  { slug: "gtdmemo", name: "GTDメモ", desc: "頭の中を、すっきり整理。", icon: "/assets/apps/gtdmemo-icon.png" },
  { slug: "inkpress", name: "InkPress", desc: "軽くて静かな自炊本リーダー。", icon: "/assets/apps/inkpress-icon.png" },
];
---

<BaseLayout title={`${data.title} — Y.M Apps`} description={data.tagline} ogImage={data.coverImage}>
  <section class="stack-section">
    <div class="container detail-page">

      <nav class="crumb">
        <a href="/">Home</a><span class="sep">/</span>
        <a href="/#works">Works</a><span class="sep">/</span>
        <span class="cur">{data.title}</span>
      </nav>

      <section class="detail-hero" data-reveal>
        <div class="hero-banner">
          <img src="/assets/hero/kirokunavi-hero.png" alt="きろくナビ — 体温・作業・送迎・欠席対応まで、1画面で。" />
        </div>
        <div class="card meta-bar">
          <div class="mb-status"><span class="badge-soon">一般配布は準備中 — 導入のご相談を受け付けています</span></div>
          <div class="mb-chips">
            <span class="chip">Android</span>
            <span class="chip">v{data.version}</span>
            <span class="chip chip-gold">福祉の記録</span>
            <span class="chip">完全オフライン</span>
          </div>
          <div class="mb-actions">
            <a class="btn btn-primary" href="/contact?from=kirokunavi">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16v12H4z M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
              導入のご相談・お問い合わせ
            </a>
          </div>
        </div>
      </section>

      <div class="detail-body">

        <section class="block" data-reveal>
          <span class="lede">ABOUT</span>
          <h2>このアプリについて</h2>
          <div class="about-text">
            <p>利用者さんの体温はノート、作業の様子は日報、送迎表はホワイトボード、欠席の電話メモは付箋 ── 障害福祉の現場でバラバラになりがちな「日々の記録」を、スマホ1台にまとめるアプリです。</p>
            <p class="pull">記録・送迎・出力・設定の4タブだけ。朝開くと今日の名簿が自動で並び、タップ中心で記録が終わり、1日分がそのまま日報向けの文章になります。</p>
            <p>福祉の記録には氏名・体温・体調といった、法律上とくに慎重な扱いが求められる情報（要配慮個人情報）が含まれます。きろくナビは通信を一切しない完全オフライン設計で、この情報を「そもそも端末の外に出さない」方に振り切りました。</p>
          </div>
        </section>

        <section class="block" data-reveal>
          <span class="lede">FEATURES</span>
          <h2>主な特徴</h2>
          <div class="features">
            {features.map((f, i) => (
              <div class="feature">
                <span class="fnum">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="block" data-reveal>
          <span class="lede">SCREENS</span>
          <h2>スクリーンショット</h2>
          <div class="shots">
            {shots.map((s) => (
              <a class="shot" href={s.src} target="_blank" rel="noopener noreferrer"><img src={s.src} alt={s.alt} loading="lazy" decoding="async" /></a>
            ))}
          </div>
        </section>

      </div>

      <section class="other" data-reveal>
        <h2>ほかの作品</h2>
        <div class="other-grid">
          {otherWorks.map((w) => (
            <a class="owork" href={`/works/${w.slug}`}>
              <span class="oi"><img src={w.icon} alt="" /></span>
              <span><b>{w.name}</b><span>{w.desc}</span></span>
            </a>
          ))}
        </div>
        <a class="back-link" href="/#works">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          Works に戻る
        </a>
      </section>

    </div>
  </section>
</BaseLayout>
