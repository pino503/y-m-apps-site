<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Y.M Apps home">
      <span class="brand-mark"><img src="/assets/favicon.png" alt="" /></span>
      <span><span class="brand-name">Y.M Apps</span><span class="brand-by">&nbsp;by PINO</span></span>
    </a>
    <nav class="nav" aria-label="主要ナビゲーション">
      <a href="/#works">Works</a>
      <a href="/writings">Writings</a>
      <a href="/#about">About</a>
      <a href="/#contact">Contact</a>
    </nav>
    <span class="visitors"><span class="lbl">VISITORS</span><span class="num" id="visit-count" data-visitor-count>······</span></span>
  </div>
</header>

<script>
  import { createVisitorCounter } from '../scripts/visits-client.js';

  const updateVisits = createVisitorCounter({
    hostname: location.hostname,
    getElement: () => document.getElementById('visit-count'),
    request: (url: string) => fetch(url, { signal: AbortSignal.timeout(8000) }),
  });
  document.addEventListener('astro:page-load', updateVisits);
  updateVisits();
</script>
